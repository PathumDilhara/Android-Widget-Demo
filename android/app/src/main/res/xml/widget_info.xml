<!--    ## 1. XML declaration-->

<!--    ```xml-->
<!--    <?xml version="1.0" encoding="utf-8"?>-->
<!--    ```-->

<!--    This tells Android that this file is an **XML document**.-->

<!--    * `version="1.0"` → XML version.-->
<!--    * `encoding="utf-8"` → character encoding.-->
