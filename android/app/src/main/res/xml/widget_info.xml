<!--    So you can think of the two XML files like this:-->

<!--    ```text-->
<!--    YOUR WIDGET-->
<!--    │-->
<!--    ┌───────────┴───────────┐-->
<!--    │                       │-->
<!--    ↓                       ↓-->
<!--    widget_info.xml         widget_layout.xml-->
<!--    "Widget rules"          "Widget UI"-->
<!--    │                       │-->
<!--    ├─ minWidth             ├─ TextView-->
